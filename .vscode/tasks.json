{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --workflow --preset Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\flash.ps1\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []

        },
        {
            "label": "Open",
            "type": "shell",
            "command": "D:\\soft\\dev\\STM32CubeMX\\STM32CubeMX.exe \"${workspaceFolder}\\pro.ioc\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
